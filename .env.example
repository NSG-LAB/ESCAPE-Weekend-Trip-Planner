# ==========================================
# ESCAPE — Weekend Trip Planner Environment
# ==========================================

# Application title displayed in header and metadata
VITE_APP_TITLE="ESCAPE — Weekend Trip Planner"

# Enable static mock dataset (always true for offline frontend-first mode)
VITE_ENABLE_MOCK_DATA=true

# Mock travel cost currency symbol
VITE_DEFAULT_CURRENCY="₹"

# Default weekend trip duration in hours
VITE_DEFAULT_DURATION_HOURS=48
